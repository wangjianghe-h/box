#!/system/bin/sh

scripts_dir="${0%/*}"
settings_file="/data/adb/box/settings.ini"
[ -f "${settings_file}" ] && . "${settings_file}"

box_dir="/data/adb/box"
box_run="${box_dir}/run"
box_run_state="${box_dir}/run/state"
box_log="${box_run}/runs.log"
box_pid="${box_run}/box.pid"
box_db="${box_dir}/box.db"
boxctl="${box_dir}/bin/boxctl"
boxdb="${box_dir}/bin/boxdb"

mkdir -p "${box_run}" "${box_run_state}" >/dev/null 2>&1 || true

say() {
  printf '%s [%s]: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" "$2" | tee -a "${box_log}" 2>/dev/null
}

stop_cron() {
  command -v busybox >/dev/null 2>&1 || return 0
  busybox pkill -f "busybox crond" >/dev/null 2>&1 || true
}

start_cron() {
  stop_cron
  command -v busybox >/dev/null 2>&1 || return 0
  [ "${run_crontab}" = "true" ] || return 0
  busybox crontab -c "${box_run_state}" -r >/dev/null 2>&1 || true
  echo "# root 的定时任务" > "${box_run_state}/root"
  if [ "${update_subscription}" = "true" ] || [ "${update_geo}" = "true" ]; then
    echo "${interva_update} ${scripts_dir}/box.tool geosub" >> "${box_run_state}/root"
  fi
  [ -f "${box_dir}/crontab.cfg" ] && cat "${box_dir}/crontab.cfg" >> "${box_run_state}/root"
  chmod 0644 "${box_run_state}/root" 2>/dev/null || true
  nohup busybox crond -c "${box_run_state}" >/dev/null 2>&1 &
}

sync_db() {
  [ -x "${boxdb}" ] || {
    say Error "boxdb 不存在，无法同步数据库"
    return 1
  }
  if ! "${boxdb}" sync --home "${box_dir}" >>"${box_log}" 2>&1; then
    say Error "同步 box.db 失败，请查看 ${box_log}"
    return 1
  fi
}

CORE=""
CORE_CFG=""
pick_core() {
  CORE="$1"
  [ -n "${CORE}" ] || return 0
  case "${CORE}" in
    mihomo) CORE_CFG="${box_dir}/mihomo/${name_mihomo_config:-config.yaml}" ;;
    sing-box) CORE_CFG="${box_dir}/sing-box/${name_sing_config:-config.json}" ;;
    xray) CORE_CFG="${box_dir}/xray/${name_xray_config:-config.json}" ;;
    v2fly) CORE_CFG="${box_dir}/v2fly/${name_v2fly_config:-config.json}" ;;
    hysteria) CORE_CFG="${box_dir}/hysteria/${name_hysteria_config:-config.yaml}" ;;
    *) CORE_CFG="" ;;
  esac
}

run_boxctl() {
  cmd="$1"
  set -- --home "${box_dir}" --db "${box_db}"
  if [ -n "${CORE}" ] && [ -n "${CORE_CFG}" ]; then
    set -- "$@" --core "${CORE}" --config "${CORE_CFG}"
  fi
  "${boxctl}" "$@" "${cmd}"
}

[ -x "${boxctl}" ] || {
  say Error "boxctl 不存在或不可执行: ${boxctl}"
  exit 1
}

case "$1" in
  start)
    sync_db || exit 1
    run_boxctl boot || exit $?
    start_cron
    "${scripts_dir}/box.tool" webroot >/dev/null 2>&1 || true
    ;;
  stop)
    stop_cron
    [ -f "${box_db}" ] && run_boxctl down
    ;;
  restart)
    pick_core "$2"
    sync_db || exit 1
    run_boxctl restart || exit $?
    start_cron
    "${scripts_dir}/box.tool" webroot >/dev/null 2>&1 || true
    ;;
  status)
    [ -f "${box_db}" ] || exit 0
    run_boxctl status
    ;;
  *)
    echo "用法: $0 {start|stop|restart|status} [core]" >&2
    exit 1
    ;;
esac
