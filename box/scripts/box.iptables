#!/system/bin/sh

scripts_dir="${0%/*}"
settings_file="/data/adb/box/settings.ini"
[ -f "${settings_file}" ] && . "${settings_file}"

box_dir="/data/adb/box"
box_run="${box_dir}/run"
box_log="${box_run}/runs.log"
box_db="${box_dir}/box.db"
boxctl="${box_dir}/bin/boxctl"
boxdb="${box_dir}/bin/boxdb"

say() {
  printf '%s [%s]: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" "$2" | tee -a "${box_log}" 2>/dev/null
}

sync_db() {
  [ -x "${boxdb}" ] || {
    say Error "boxdb 不存在，无法同步数据库"
    return 1
  }
  if ! "${boxdb}" sync --home "${box_dir}" >>"${box_log}" 2>&1; then
    say Error "同步 box.db 失败，请查看 ${box_log}"
    return 1
  fi
}

core_running() {
  [ -f "${box_dir}/run/box.pid" ] || return 1
  pid="$(cat "${box_dir}/run/box.pid" 2>/dev/null)"
  [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

[ -x "${boxctl}" ] || {
  say Error "boxctl 不存在或不可执行: ${boxctl}"
  exit 1
}

case "$1" in
  enable)
    sync_db || exit 1
    core_running || {
      say Warn "核心未运行，跳过 iptables 应用"
      exit 0
    }
    set -- --home "${box_dir}" --db "${box_db}"
    [ -n "${tproxy_port}" ] && set -- "$@" --tproxy-port "${tproxy_port}"
    [ -n "${redir_port}" ] && set -- "$@" --redir-port "${redir_port}"
    "${boxctl}" "$@" mode apply
    ;;
  renew)
    sync_db || exit 1
    set -- --home "${box_dir}" --db "${box_db}"
    [ -n "${tproxy_port}" ] && set -- "$@" --tproxy-port "${tproxy_port}"
    [ -n "${redir_port}" ] && set -- "$@" --redir-port "${redir_port}"
    "${boxctl}" "$@" mode renew
    ;;
  disable)
    [ -f "${box_db}" ] && "${boxctl}" --db "${box_db}" mode clear
    ;;
  *)
    echo "用法: $0 {enable|disable|renew}" >&2
    exit 1
    ;;
esac
